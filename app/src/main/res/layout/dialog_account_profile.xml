<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/yt_dark_surface"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/yt_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- LOGGED IN VIEW -->
        <LinearLayout
            android:id="@+id/layout_logged_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_dialog_user_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_account_circle"
                android:background="@color/yt_card_background"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <TextView
                android:id="@+id/tv_dialog_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="User Name"
                android:textColor="@color/yt_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dialog_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="user@gmail.com"
                android:textColor="@color/yt_text_secondary"
                android:textSize="13sp" />

            <!-- Google Connected Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_rounded_chip"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_google_logo"
                    android:contentDescription="Google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Connected with Gmail"
                    android:textColor="@color/yt_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="20dp"
                android:background="@color/yt_divider" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_sign_out"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Sign Out"
                android:textColor="@color/yt_white"
                android:backgroundTint="@color/yt_chip_background"
                app:cornerRadius="24dp"
                android:textAllCaps="false"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- NOT LOGGED IN VIEW -->
        <LinearLayout
            android:id="@+id/layout_not_logged_in"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_google_logo"
                android:contentDescription="Google Sign In" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sign in with Google / Gmail"
                android:textColor="@color/yt_white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAlignment="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Connect your Gmail account to sync your playlists, history, and preferences seamlessly."
                android:textColor="@color/yt_text_secondary"
                android:textSize="13sp"
                android:textAlignment="center"
                android:lineSpacingExtra="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_google_signin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:text="Choose Gmail Account"
                android:textColor="#0F0F0F"
                android:backgroundTint="@color/yt_white"
                app:icon="@drawable/ic_google_logo"
                app:iconTint="@null"
                app:iconGravity="textStart"
                app:cornerRadius="25dp"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dialog_manual_signin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="Enter Gmail Manually"
                android:textColor="@color/yt_white"
                android:backgroundTint="@color/yt_chip_background"
                app:cornerRadius="24dp"
                android:textAllCaps="false"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_dialog_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Continue as Guest"
                android:textColor="@color/yt_text_secondary"
                android:textSize="13sp"
                android:padding="8dp"
                android:background="?selectableItemBackgroundBorderless" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
