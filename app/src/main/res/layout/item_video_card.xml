<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="16dp"
    android:background="?selectableItemBackground">

    <!-- 16:9 Thumbnail Frame -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="@color/yt_card_background"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="Video Thumbnail" />

        <!-- Duration Badge -->
        <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_duration_badge"
            android:text="10:25"
            android:textColor="@color/yt_white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/iv_thumbnail"
            app:layout_constraintEnd_toEndOf="@id/iv_thumbnail" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Info Row: Avatar + Title/Channel info + 3-dots -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:gravity="top">

        <!-- Channel Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_channel_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_subscriptions"
            android:tint="@color/yt_white"
            android:background="@color/yt_card_background"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Video Title Here"
                android:textColor="@color/yt_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Channel Name · 1.5M views · 2 days ago"
                android:textColor="@color/yt_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- More Options Button -->
        <ImageView
            android:id="@+id/btn_more_options"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/yt_text_secondary"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Options" />

    </LinearLayout>

</LinearLayout>
