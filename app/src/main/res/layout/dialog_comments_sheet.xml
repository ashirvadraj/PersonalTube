<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="520dp"
    android:orientation="vertical"
    android:background="@color/yt_dark_surface">

    <!-- Top Drag Handle & Header -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_pill_button"
        android:backgroundTint="@color/yt_border" />

    <!-- Comments Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comments"
            android:textColor="@color/yt_white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_sheet_comment_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="1.8K"
            android:textColor="@color/yt_text_secondary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btn_close_comments"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:tint="@color/yt_white"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Close Comments" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yt_divider" />

    <!-- Comments List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_comments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/yt_divider" />

    <!-- Bottom Add Comment Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:background="@color/yt_black">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_account_circle"
            android:tint="@color/yt_white" />

        <EditText
            android:id="@+id/et_new_comment"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_rounded_chip"
            android:hint="@string/add_comment"
            android:textColorHint="@color/yt_text_secondary"
            android:textColor="@color/yt_white"
            android:textSize="13sp"
            android:paddingHorizontal="14dp"
            android:maxLines="1"
            android:inputType="text" />

        <ImageView
            android:id="@+id/btn_send_comment"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_share"
            android:tint="@color/yt_accent_blue"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Send Comment" />

    </LinearLayout>

</LinearLayout>
